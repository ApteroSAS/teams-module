{
  "name": "@aptero/axolotis-module-teams",
  "version": "1.0.0",
  "description": "Axolotis - Teams module",
  "main": "build/index.js",
  "exports": {
    ".": "build/index.js",
    "./*": "./build/@aptero/axolotis-module-teams/*"
  },
  "types": "build/types/index.d.ts",
  "scripts": {
    "build": "webpack && tsc && ttsc --emitDeclarationOnly",
    "start": "cross-env OPEN=true yarn run dev",
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.demo.js",
    "dev:watch": "tsc-watch --onSuccess \"yarn run only-build\"",
    "ci:test": "cross-env NODE_ENV=development npx playwright test",
    "ci:test:debug": "cross-env NODE_ENV=development npx playwright test --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.demo.js && npx http-server dist -p 9080",
    "ci:coverage": "cross-env NODE_ENV=development npx playwright test && nyc --no-clean yarn --version",
    "ci": "cross-env CI=true start-server-and-test ci:coverage:serve http://localhost:9080 ci:coverage"
  },
  "author": "Aptero <admin@aptero.co>",
  "homepage": "https://aptero.co",
  "keywords": [
    "library",
    "teams",
    "microsoft",
    "es6"
  ],
  "devDependencies": {
    "@svgr/webpack": "^5.4.0",
    "stylelint-config-recommended-scss": "^3.2.0",
    "stylelint-scss": "^3.5.3",
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.9",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/plugin-transform-typescript": "^7.16.8",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.16.11",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.21.1",
    "@types/three": "^0.139.0",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.2.4",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-preset-minify": "^0.5.1",
    "copy-webpack-plugin": "^10.2.4",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "eslint": "^8.13.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.0",
    "mini-css-extract-plugin": "^2.6.0",
    "nyc": "^15.1.0",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "playwright": "^1.21.0",
    "prettier": "^1.7.0",
    "prettier-webpack-plugin": "^1.2.0",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^1.14.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.1",
    "ts-node": "^10.7.0",
    "tsc-watch": "^5.0.3",
    "ttypescript": "^1.5.13",
    "typescript": "^4.6.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "@calm/eslint-plugin-react-intl": "^1.4.1",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-prettier": "^2.6.2",
    "eslint-plugin-react": "^7.10.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "webpack-dev-server": "4.8.1"
  },
  "dependencies": {
    "phoenix": "github:gfodor/phoenix-js#f4cebf1534dd7c503fe797ef396709c4d3ea8d69",
    "react": "^16.13.1",
    "uuid": "^3.2.1",
    "react-intl": "^5.10.1",
    "@fluentui/react-northstar": "^0.61.0",
    "@azure/msal-browser": "2.16.1",
    "@microsoft/microsoft-graph-client": "^3.0.2",
    "@microsoft/teams-js": "^1.12.1",
    "@microsoft/teamsfx": "^0.7.1-beta.c23501411.0",
    "@aptero/axolotis-player": "https://github.com/ApteroSAS/axolotis-player.git#7b83a4cba43a6181940dc0803e8dd501cde60f4c",
    "eventemitter3": "^4.0.7",
    "tsutils": "^3.21.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
