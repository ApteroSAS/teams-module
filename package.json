{
  "name": "@aptero/axolotis-module-teams",
  "version": "1.0.0",
  "description": "Axolotis - Teams module",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c",
    "start": "chokidar 'src/**/*' -c 'npm run build'",
    "ci:test": "cross-env NODE_ENV=development npx playwright test",
    "ci:test:debug": "cross-env NODE_ENV=development npx playwright test --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.demo.js && npx http-server dist -p 9080",
    "ci:coverage:build": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 npm run build",
    "ci:coverage": "cross-env NODE_ENV=development npx playwright test && nyc --no-clean",
    "ci": "cross-env CI=true start-server-and-test ci:coverage:serve http://localhost:9080 ci:coverage"
  },
  "author": "Aptero <admin@aptero.co>",
  "homepage": "https://aptero.co",
  "keywords": [
    "library",
    "teams",
    "microsoft",
    "es6"
  ],
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.42.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "buffer": "^6.0.3",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "http-server": "^14.1.1",
    "nyc": "^15.1.0",
    "playwright": "^1.42.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.10",
    "rollup": "^4.13.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^2.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "typescript-transform-paths": "^3.4.7"
  },
  "dependencies": {
    "@aptero/axolotis-module-basic": "workspace:*",
    "@azure/msal-browser": "^3.26.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/teams-js": "^2.21.0",
    "@microsoft/teamsfx": "^2.3.1",
    "@swc/core": "^1.4.8",
    "eventemitter3": "^5.0.1",
    "inversify": "^6.0.2",
    "reflect-metadata": "^0.2.1",
    "tsup": "^8.0.2",
    "tsutils": "^3.21.0"
  }
}
