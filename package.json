{
  "name": "@aptero/axolotis-module-teams",
  "version": "1.0.0",
  "description": "Axolotis - Teams module",
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./*": "./build/*"
  },
  "types": "build/index.d.ts",
  "scripts": {
    "build": "rimraf ./build/ && ttsc && webpack",
    "start": "cross-env OPEN=true yarn run dev",
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.demo.js",
    "build:dev": "cross-env DEVTOOL=eval-source-map yarn run build",
    "dev:watch": "cross-env DEVTOOL=eval-source-map tsc-watch --onSuccess \"webpack\"",
    "ci:test": "cross-env NODE_ENV=development npx playwright test",
    "ci:test:debug": "cross-env NODE_ENV=development npx playwright test --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.demo.js && npx http-server dist -p 9080",
    "ci:coverage:build": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 yarn run build",
    "ci:coverage": "cross-env NODE_ENV=development npx playwright test && nyc --no-clean yarn --version",
    "ci": "cross-env CI=true start-server-and-test ci:coverage:serve http://localhost:9080 ci:coverage",
  },
  "author": "Aptero <admin@aptero.co>",
  "homepage": "https://aptero.co",
  "keywords": [
    "library",
    "teams",
    "microsoft",
    "es6"
  ],
  "devDependencies": {
    "@aptero/axolotis-module-basic": "https://github.com/ApteroSAS/basic-modules#d259f4c406cff014a52b1921dc40039076dd1ef5",
    "@aptero/axolotis-player": "git+https://github.com/ApteroSAS/axolotis-player.git#3f8fff8508fa9dcb18c40214685ab28027e104a1",
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.18.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-typescript": "^7.18.8",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/jest": "^28.1.4",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.2.5",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-preset-minify": "^0.5.2",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "jest": "^28.1.2",
    "jest-environment-jsdom": "^28.1.2",
    "jest-junit": "^14.0.0",
    "mini-css-extract-plugin": "^2.6.1",
    "nyc": "^15.1.0",
    "prettier": "^2.7.1",
    "prettier-webpack-plugin": "^1.2.0",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^1.14.0",
    "terser-webpack-plugin": "^5.3.3",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.8.2",
    "tsc-watch": "^5.0.3",
    "ttypescript": "^1.5.13",
    "typescript": "^4.7.4",
    "typescript-transform-paths": "^3.3.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "4.9.3"
  },
  "dependencies": {
    "@azure/msal-browser": "2.27.0",
    "@microsoft/microsoft-graph-client": "^3.0.2",
    "@microsoft/teams-js": "^2.0.0",
    "@microsoft/teamsfx": "^1.0.0",
    "tsutils": "^3.21.0"
  },
  "peerDependencies": {
    "@aptero/axolotis-module-basic": "https://github.com/ApteroSAS/basic-modules#semver:^1.0.0",
    "@aptero/axolotis-player": "git+https://github.com/ApteroSAS/axolotis-player.git#semver:^1.0.0"
  }
}
