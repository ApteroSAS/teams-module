{
  "name": "@aptero/axolotis-module-teams",
  "version": "1.0.0",
  "description": "Axolotis - Teams module",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.async": {
      "import": "./dist/index.async.js",
      "require": "./dist/index.async.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "ci:test": "cross-env NODE_ENV=development npx playwright test",
    "ci:test:debug": "cross-env NODE_ENV=development npx playwright test --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.demo.js && npx http-server dist -p 9080",
    "ci:coverage:build": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 yarn run build",
    "ci:coverage": "cross-env NODE_ENV=development npx playwright test && nyc --no-clean yarn --version",
    "ci": "cross-env CI=true start-server-and-test ci:coverage:serve http://localhost:9080 ci:coverage"
  },
  "author": "Aptero <admin@aptero.co>",
  "homepage": "https://aptero.co",
  "keywords": [
    "library",
    "teams",
    "microsoft",
    "es6"
  ],
  "devDependencies": {
    "@aptero/axolotis-player": "github:ApteroSAS/axolotis-player.git#semver:^2.1.6",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.34.2",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "cross-env": "^7.0.3",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.7.6",
    "nyc": "^15.1.0",
    "playwright": "^1.34.2",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^2.0.0",
    "typescript": "^5.0.4",
    "typescript-transform-paths": "^3.4.6",
    "url-loader": "^4.1.1"
  },
  "dependencies": {
    "@aptero/axolotis-module-basic": "*",
    "@azure/msal-browser": "2.37.1",
    "@microsoft/microsoft-graph-client": "^3.0.5",
    "@microsoft/teams-js": "^2.12.0",
    "@microsoft/teamsfx": "^2.2.1",
    "inversify-react": "^1.1.0",
    "reflect-metadata": "^0.1.13",
    "tsup": "^6.7.0",
    "tsutils": "^3.21.0"
  },
  "browser": {
    "[module-name]": false
  }
}
