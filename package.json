{
  "name": "@aptero/axolotis-module-teams",
  "version": "1.0.0",
  "description": "Axolotis - Teams module",
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./*": "./build/*"
  },
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc && webpack && ttsc --emitDeclarationOnly",
    "start": "cross-env OPEN=true yarn run dev",
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.demo.js",
    "dev:watch": "cross-env DEVTOOL=eval-source-map tsc-watch --onSuccess \"yarn run build\"",
    "ci:test": "cross-env NODE_ENV=development npx playwright test",
    "ci:test:debug": "cross-env NODE_ENV=development npx playwright test --headed",
    "ci:coverage:serve": "cross-env NODE_ENV=development USE_BABEL_PLUGIN_ISTANBUL=1 webpack --stats-error-details --config webpack.config.demo.js && npx http-server dist -p 9080",
    "ci:coverage": "cross-env NODE_ENV=development npx playwright test && nyc --no-clean yarn --version",
    "ci": "cross-env CI=true start-server-and-test ci:coverage:serve http://localhost:9080 ci:coverage"
  },
  "author": "Aptero <admin@aptero.co>",
  "homepage": "https://aptero.co",
  "keywords": [
    "library",
    "teams",
    "microsoft",
    "es6"
  ],
  "devDependencies": {
    "@aptero/axolotis-player": "git+https://github.com/ApteroSAS/axolotis-player.git#semver:^1",
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.2",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-transform-typescript": "^7.18.4",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-typescript": "^7.17.12",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.22.2",
    "@types/js-cookie": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.2.5",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-preset-minify": "^0.5.2",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.16.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "http-server": "^14.1.1",
    "nyc": "^15.1.0",
    "playwright": "^1.22.2",
    "prettier": "^2.6.2",
    "prettier-webpack-plugin": "^1.2.0",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^1.14.0",
    "terser-webpack-plugin": "^5.3.1",
    "ts-node": "^10.8.0",
    "tsc-watch": "^5.0.3",
    "ttypescript": "^1.5.13",
    "typescript": "^4.7.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.72.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "4.9.1"
  },
  "peerDependencies": {
    "@aptero/axolotis-player": "git+https://github.com/ApteroSAS/axolotis-player.git#semver:^1"
  },
  "dependencies": {
    "@azure/msal-browser": "2.16.1",
    "@microsoft/microsoft-graph-client": "^3.0.2",
    "@microsoft/teams-js": "^1.12.1",
    "@microsoft/teamsfx": "^1.0.0",
    "deepmerge": "^4.2.2",
    "event-target-shim": "^6.0.2",
    "eventemitter3": "^4.0.7",
    "js-cookie": "^2.2.0",
    "jsonschema": "^1.2.2",
    "phoenix": "github:gfodor/phoenix-js#f4cebf1534dd7c503fe797ef396709c4d3ea8d69",
    "tsutils": "^3.21.0",
    "uuid": "^3.2.1"
  }
}
